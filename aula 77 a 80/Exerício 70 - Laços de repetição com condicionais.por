programa {
  funcao inicio() {
    inteiro n 


    faca{
     
      escreva("Digite um número: ")
      leia(n)

      se(n > 0){
        escreva("Número positivo. ")
      } senao se (n <= -1){
        escreva("Número negativo. ")
      } senao{
        n == 0
        escreva("Número 0")
      }


    } enquanto(n==0)
    
  }
}
