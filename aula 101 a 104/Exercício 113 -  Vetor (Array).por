programa {
  funcao inicio() {
    
    inteiro numero[5] 

    escreva("Informe um número para a primeira posição: ")
    leia(numero[0])

  
    escreva("Informe um número para a segunda posição: ")
    leia(numero[1])

    escreva("Informe um número para a terceira posição: ")
    leia(numero[2])

    numero[3] = 20
    numero[4] = 500

    escreva(numero[0], "\n")
    escreva(numero[1], "\n")
    escreva(numero[2], "\n")
    escreva(numero[3], "\n")
    escreva(numero[4])
  
  }
}
